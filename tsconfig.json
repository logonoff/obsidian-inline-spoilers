{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "esnext",
    "target": "es2021",
    "allowJs": false,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "lib": ["es2021", "DOM"]
  },
  "include": [
    "**/*.ts"
  ]
}
