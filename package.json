{
	"name": "obsidian-inline-spoilers",
	"author": "logonoff",
	"version": "1.2.7",
	"private": true,
	"description": "Adds Discord-like syntax for inline spoilers.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/logonoff/obsidian-inline-spoilers"
	},
	"bugs": {
		"url": "https://github.com/logonoff/obsidian-inline-spoilers/issues"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"spoilers"
	],
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "npm install && node version-bump.mjs && git add manifest.json versions.json package-lock.json",
		"lint": "eslint . --max-warnings=0"
	},
	"devDependencies": {
		"@codemirror/language": "6.12.4",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"esbuild": "0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript-eslint": "8.72.0",
		"typescript": "6.0.3"
	}
}
