{
	"name": "obsidian-inline-spoilers",
	"author": "logonoff",
	"version": "1.2.7",
	"private": true,
	"description": "Adds Discord-like syntax for inline spoilers.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/logonoff/obsidian-inline-spoilers"
	},
	"bugs": {
		"url": "https://github.com/logonoff/obsidian-inline-spoilers/issues"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"spoilers"
	],
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "npm install && node version-bump.mjs && git add manifest.json versions.json package-lock.json",
		"lint": "eslint . --max-warnings=0"
	},
	"devDependencies": {
		"@codemirror/language": "^6.12.1",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.2",
		"@types/node": "^25.9.1",
		"esbuild": "0.28.0",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "0.1.9",
		"obsidian": "1.12.3",
		"tslib": "2.8.1",
		"typescript-eslint": "8.60.1",
		"typescript": "6.0.3"
	}
}
